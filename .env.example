# ── Ideogram 4.0 Local Studio ─ Environment Variables ──────────────────────
# Copy this file to .env and fill in your keys before first run.

# HuggingFace user access token
# Required to download gated model weights (ideogram-ai/ideogram-4-*)
# Get yours at: https://huggingface.co/settings/tokens
# You must also accept the license at:
#   https://huggingface.co/ideogram-ai/ideogram-4-fp8
#   https://huggingface.co/ideogram-ai/ideogram-4-nf4
HF_TOKEN=

# Magic Prompt backend: openrouter-v1 | ideogram-4-v1 | claude-sonnet-v1 | claude-opus-v1
# All backends weave style into the description prose (none return the
# caption's style section); the app preserves your Style settings.
MAGIC_PROMPT_BACKEND=ideogram-4-v1

# Ideogram API key — required for the "ideogram-4-v1" magic prompt backend
# Free at: https://developer.ideogram.ai
IDEOGRAM_API_KEY=

# OpenRouter API key — required for the openrouter-v1 / claude-sonnet-v1 /
# claude-opus-v1 backends, and preferred for the AI style fuse.
# Get at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model for OpenRouter-backed features (openrouter-v1 magic prompt, AI fuse).
# Default is a FREE model ($0). When a ":free" model is set, the app sends a
# fallback chain so a busy free provider auto-falls-back instead of failing.
# Other good free picks: meta-llama/llama-3.3-70b-instruct:free,
# qwen/qwen3-next-80b-a3b-instruct:free, openai/gpt-oss-120b:free.
# For max reliability / no daily caps, use a cheap paid model like
# google/gemini-2.5-flash-lite (~$0.0001/call). Free models are rate-limited
# (~20/min, 50/day, or 1000/day after a one-time $10 credit purchase).
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Hard safeguard: when true (default), the app NEVER sends a paid model to
# OpenRouter — paid model ids are coerced to the free default and the paid
# Claude backends are routed to free OpenRouter — so purchased credits are
# never spent. Set false only if you deliberately want to use paid models.
OPENROUTER_FREE_ONLY=true

# Auto-structure: expand a sparse prompt into a full structured-JSON scene
# (via the magic-prompt backend) before each generation. Ideogram 4 paints its
# gray "safety filter" refusal far less often on richly structured JSON than on
# sparse prompts. Opt-in; needs a magic-prompt backend configured above.
AUTO_STRUCTURE_PROMPT=false

# Default model variant: nf4d (recommended for 24 GB consumer GPUs — adds live
# progress, LoRA, and inpaint), nf4, fp8, or bf16.
MODEL_VARIANT=nf4d

# Preload the model in the background at startup (run.bat sets this to true):
# downloads on first run, ready-to-go afterwards. The UI opens immediately and
# shows load progress. Set PRELOAD_MODEL=false to load only on demand instead.
PRELOAD_MODEL=false
PRELOAD_VARIANT=nf4d

# ── Optional content moderation (Hive) ────────────────────────────────────
# This is the ONLY content filter in the app — there is no local/weight
# toggle (the model's own refusals live in its weights and can't be switched
# off in software). When OFF (default), prompts and images are never screened.
# When ON *and* a Hive key is present, each generation is screened and blocked
# on a positive hit. Get keys at https://thehive.ai. Both screens fail OPEN:
# if Hive errors, generation is allowed and the error is logged.
SAFETY_MODERATION_ENABLED=false
HIVE_TEXT_KEY=
HIVE_VISUAL_KEY=

# LoRA adapters: drop downloaded *.safetensors files (e.g. from Civitai) into
# the ./loras folder. They appear in the LoRA panel when a diffusers-based
# model (NF4·D or BF16) is loaded — fp8/nf4 cannot load adapters.
